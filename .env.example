# ===== LLM（OpenAI 兼容端点，默认对接智谱 GLM）=====
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-plus

# ===== 网关鉴权（多个 key 用逗号分隔）=====
MINACLAW_API_KEYS=dev-key-123

# ===== 日志 =====
LOG_LEVEL=INFO
# LOG_DIR=/path/to/logs
LOG_JSON=true

# ===== Token 预算 =====
DAILY_TOKEN_QUOTA=1000000
DAILY_TOKEN_WARN=800000

# ===== SMTP（邮件技能）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=claw@example.com
