# ===== LLM（OpenAI 兼容端点，默认对接智谱 GLM）=====
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OPENAI_MODEL=glm-4-plus

# ===== 网关鉴权（多个 key 用逗号分隔）=====
MINACLAW_API_KEYS=dev-key-123

# ===== 日志 =====
LOG_LEVEL=INFO
# LOG_DIR=/path/to/logs
LOG_JSON=true

# ===== Token 预算 =====
DAILY_TOKEN_QUOTA=1000000
DAILY_TOKEN_WARN=800000

# ===== 技能渐进式加载（tools 仅注入摘要，详情经 load_skill 按需获取）=====
SKILL_PROGRESSIVE=true

# ===== 技能上传（zip 目录包，Agent Skills 开放标准）=====
SKILL_UPLOAD_ENABLED=true
SKILL_UPLOAD_MAX_ZIP_MB=5
SKILL_UPLOAD_MAX_TOTAL_MB=20
SKILL_UPLOAD_MAX_FILES=50

# ===== SMTP（邮件技能）=====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=claw@example.com
